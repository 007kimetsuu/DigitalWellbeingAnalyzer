<uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

<application
android:allowBackup="true"
android:dataExtractionRules="@xml/data_extraction_rules"
android:fullBackupContent="@xml/backup_rules"
android:icon="@mipmap/ic_launcher"
android:label="@string/app_name"
android:roundIcon="@mipmap/ic_launcher_round"
android:supportsRtl="true"
android:theme="@style/Theme.DigitalWellbeingAnalyzer">

<activity
    android:name=".views.LoginActivity"
    android:exported="false" />

<activity
    android:name=".views.RegisterActivity"
    android:exported="false"
    android:windowSoftInputMode="adjustResize" />

<activity
    android:name=".views.ForgotPasswordActivity"
    android:exported="false" />

<activity
    android:name=".views.DashboardActivity"
    android:exported="false" />

<activity
    android:name=".views.ProfileActivity"
    android:exported="false" />

<activity
    android:name=".views.SplashActivity"
    android:exported="true">

    <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
    </intent-filter>

</activity>

<activity
    android:name=".views.EditProfileActivity"
    android:exported="false"
    android:windowSoftInputMode="adjustResize" />

<!-- Analytics screens -->
<activity
    android:name=".views.AnalyticsActivity"
    android:exported="false" />

<activity
    android:name=".views.M2AnalyticsActivity"
    android:exported="false" />

<activity
    android:name=".views.activity_analytics_risk"
    android:exported="false" />

<activity
    android:name=".views.InsightsActivity"
    android:exported="false" />

</application>