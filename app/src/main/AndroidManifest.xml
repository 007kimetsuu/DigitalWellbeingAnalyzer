<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DigitalWellbeingAnalyzer">

        <activity
            android:name=".views.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".views.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".views.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".views.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".views.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.AnalyticsActivity"
            android:exported="false" />

        <activity
            android:name=".views.M2AnalyticsActivity"
            android:exported="false" />

        <activity
            android:name=".views.activity_analytics_risk"
            android:exported="false" />

        <activity
            android:name=".views.InsightsActivity"
            android:exported="false" />

        <activity
            android:name=".views.GuideActivity"
            android:exported="false" />

        <activity
            android:name=".views.BehaviorAnalysisActivity"
            android:exported="false" />

        <activity
            android:name=".views.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".AdvancedContextService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>

</manifest>