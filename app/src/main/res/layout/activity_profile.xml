<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FC">

    <!-- ========================================= -->
    <!-- SCROLLABLE CONTENT                        -->
    <!-- ========================================= -->

    <ScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ================================= -->
            <!-- HEADER                            -->
            <!-- ================================= -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Small profile icon -->

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_profile_circle"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#5046E5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/profileGreetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Good morning, Student"
                        android:textColor="#5046E5"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/profileSettingsIcon"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="#303030"
                    android:textSize="20sp" />

            </RelativeLayout>


            <!-- ================================= -->
            <!-- PROFILE CARD                       -->
            <!-- ================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/profileInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Profile Avatar -->

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp">

                        <ImageView
                            android:id="@+id/profileImage"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_profile_circle"
                            android:contentDescription="Profile photo"
                            android:padding="18dp"
                            android:src="@drawable/ic_person" />

                        <!-- Edit circle -->

                        <TextView
                            android:id="@+id/editProfileIcon"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_profile_circle"
                            android:gravity="center"
                            android:text="✎"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                    </FrameLayout>


                    <!-- Name -->

                    <TextView
                        android:id="@+id/profileNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Student Name"
                        android:textColor="#20202A"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <!-- Email -->

                    <TextView
                        android:id="@+id/profileEmailText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="student@email.com"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <!-- Occupation -->

                    <TextView
                        android:id="@+id/profileOccupationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#5CFF8B"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="Occupation: Student"
                        android:textColor="#176B35"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================= -->
            <!-- SETTINGS LABEL                    -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="20dp"
                android:text="SETTINGS"
                android:textColor="#77718A"
                android:textSize="10sp"
                android:textStyle="bold" />


            <!-- ================================= -->
            <!-- SETTINGS CARD                     -->
            <!-- ================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Notification -->

                    <LinearLayout
                        android:id="@+id/notificationSettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="#EEEAFE"
                            android:gravity="center"
                            android:text="♧"
                            android:textColor="#5046E5"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Notification Settings"
                                android:textColor="#30303A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:text="Manage alerts and sounds"
                                android:textColor="#8A8794"
                                android:textSize="10sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:text="›"
                            android:textColor="#8B8794"
                            android:textSize="25sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0EEF4" />


                    <!-- Reminder -->

                    <LinearLayout
                        android:id="@+id/reminderFrequencyRow"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="#EEEAFE"
                            android:gravity="center"
                            android:text="◷"
                            android:textColor="#5046E5"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Reminder Frequency"
                                android:textColor="#30303A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/reminderFrequencyValueText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Every 2 hours"
                                android:textColor="#8A8794"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <TextView
                            android:text="›"
                            android:textColor="#8B8794"
                            android:textSize="25sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0EEF4" />


                    <!-- Break duration -->

                    <LinearLayout
                        android:id="@+id/breakDurationRow"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="#EEEAFE"
                            android:gravity="center"
                            android:text="▣"
                            android:textColor="#5046E5"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Break Duration"
                                android:textColor="#30303A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/breakDurationValueText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 minute breaks"
                                android:textColor="#8A8794"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <TextView
                            android:text="›"
                            android:textColor="#8B8794"
                            android:textSize="25sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================= -->
            <!-- APP CONTROLS LABEL                -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="18dp"
                android:text="APP CONTROLS"
                android:textColor="#77718A"
                android:textSize="10sp"
                android:textStyle="bold" />


            <!-- ================================= -->
            <!-- APP CONTROLS CARD                 -->
            <!-- ================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Dark mode -->

                    <LinearLayout
                        android:id="@+id/darkModeRow"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="#FFF0E7"
                            android:gravity="center"
                            android:text="☾"
                            android:textColor="#D77B34"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Dark Mode"
                                android:textColor="#30303A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:text="Switch app appearance"
                                android:textColor="#8A8794"
                                android:textSize="10sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/darkModeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0EEF4" />


                    <!-- Privacy -->

                    <LinearLayout
                        android:id="@+id/privacyControlsRow"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="#EEEAFE"
                            android:gravity="center"
                            android:text="♢"
                            android:textColor="#5046E5"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Privacy Controls"
                                android:textColor="#30303A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:text="Manage your data sharing"
                                android:textColor="#8A8794"
                                android:textSize="10sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:text="›"
                            android:textColor="#8B8794"
                            android:textSize="25sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0EEF4" />


                    <!-- Export -->

                    <LinearLayout
                        android:id="@+id/exportDataRow"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="#EEEAFE"
                            android:gravity="center"
                            android:text="↓"
                            android:textColor="#5046E5"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Export Data"
                                android:textColor="#30303A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:text="Download your activity history"
                                android:textColor="#8A8794"
                                android:textSize="10sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:text="›"
                            android:textColor="#8B8794"
                            android:textSize="25sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================= -->
            <!-- LOGOUT                             -->
            <!-- ================================= -->

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#FFD4D0"
                android:text="⇥  Logout"
                android:textAllCaps="false"
                android:textColor="#D9534F"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================================= -->
    <!-- BOTTOM NAVIGATION                         -->
    <!-- ========================================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#777777"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#777777"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- ANALYTICS -->

        <LinearLayout
            android:id="@+id/navAnalytics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▥"
                android:textColor="#777777"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analytics"
                android:textColor="#777777"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- GUIDES -->

        <LinearLayout
            android:id="@+id/navGuides"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◇"
                android:textColor="#777777"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guides"
                android:textColor="#777777"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- PROFILE - ACTIVE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#5046E5"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#5046E5"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>