<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Main branding group -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- MindTrack Logo -->
        <ImageView
            android:id="@+id/mindTrackLogo"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:src="@drawable/mindtrack_logo"
            android:contentDescription="MindTrack Logo" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="MindTrack"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:fontFamily="sans"
            android:gravity="center" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="112dp"
        android:text="Understand your digital habits."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <!-- Page indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="76dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Dot 1 -->
        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="4dp"
            android:background="@drawable/splash_dot" />

        <!-- Dot 2 -->
        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="4dp"
            android:background="@drawable/splash_dot_active" />

        <!-- Dot 3 -->
        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="4dp"
            android:background="@drawable/splash_dot" />

    </LinearLayout>

</FrameLayout>